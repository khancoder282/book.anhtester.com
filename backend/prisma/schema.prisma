generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  password      String
  avatarUrl     String             @db.Text
  isActive      Boolean            @default(true)
  phone         String             @default("")
  address       String             @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  book          Book[]
  config        Json?
  refreshTokens UserRefreshToken[]
  orders        Order[]

  @@index([name, email])
}

model UserRefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  deviceInfo String?  @db.Text
  ipAddress  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  name     String  @id
  isActive Boolean @default(true)
  books    Book[]  @relation("BookCategories")
}

model Promotion {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String        @db.Text
  type        PromotionType
  value       Float
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  books       Book[]        @relation("PromotionBooks")
  configFe    String        @default("{}")

  @@index([code, name])
}

model Book {
  id           String      @id @default(cuid())
  name         String      @unique
  slug         String      @unique
  description  String      @db.Text
  picture      String      @db.Text
  viewCount    Int         @default(0)
  price        Int
  currentPrice Int         @default(0)
  status       BookStatus  @default(AVAILABLE)
  // Thông tin thêm, không bắt buộc (2026-11-20)
  author       String?     @db.VarChar(191)
  publisher    String?     @db.VarChar(191)
  publishYear  Int?
  pageCount    Int?
  isbn         String?     @db.VarChar(13)
  language     String?     @db.VarChar(50)
  // Đọc thử (2026-11-21): tiêu đề + nội dung chương mẫu, không bắt buộc
  previewTitle   String?   @db.VarChar(191)
  previewContent String?   @db.Text
  authId       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auth         User?       @relation(fields: [authId], references: [id])
  categories   Category[]  @relation("BookCategories")
  promotions   Promotion[] @relation("PromotionBooks")
  orderItems   OrderItem[]

  @@index([name, slug])
}

model Address {
  id    BigInt @id @default(autoincrement())
  wards String
  div   String
}

enum BookStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// Đơn hàng (2026-11-21): giỏ hàng nằm ở trình duyệt, server chỉ lưu đơn đã đặt.
enum OrderStatus {
  PENDING
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  recipientName String        @db.VarChar(191)
  phone         String        @db.VarChar(20)
  province      String        @db.VarChar(191)
  ward          String        @db.VarChar(191)
  street        String        @db.VarChar(255)
  note          String?       @db.Text
  paymentMethod PaymentMethod @default(COD)
  subtotal      Int
  discount      Int
  shippingFee   Int
  total         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([userId, createdAt])
}

// Dòng đơn lưu ảnh chụp (snapshot) thông tin sách lúc đặt; xoá sách thì bookId = null, đơn vẫn còn.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  bookId    String?
  name      String  @db.VarChar(191)
  slug      String  @db.VarChar(191)
  // TEXT: đường dẫn ảnh sách (`/$book-image/<slug>/<file>`) có thể dài hơn 191 ký tự
  picture   String? @db.Text
  price     Int
  unitPrice Int
  quantity  Int
  lineTotal Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book      Book?   @relation(fields: [bookId], references: [id], onDelete: SetNull)
}
