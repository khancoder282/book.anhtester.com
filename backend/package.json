{
  "name": "book-anhtester-com",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts --host",
    "start": "bun run src/index.ts",
    "studio": "bunx prisma studio",
    "fake": "bun --bun src/fake.ts",
    "build:client": "cd ../frontend && bun i && bun run build && rm -rf node_modules",
    "build:server": "cd ../backend && bun i && bunx prisma generate",
    "build": "bun run build:client && bun run build:server"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/static": "^1.4.4",
    "@faker-js/faker": "^10.1.0",
    "@prisma/client": "^6.18.0",
    "dayjs": "^1.11.18",
    "elysia": "^1.4.12",
    "elysia-rate-limit": "^4.4.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react-window": "^2.2.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^6.17.1"
  },
  "module": "src/index.js"
}
