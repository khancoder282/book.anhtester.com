PORT="4566"
JWT_SECRET="<chuỗi ngẫu nhiên dài, tự sinh>"
DATABASE_URL="mysql://root:@127.0.0.1:3306/book_anhtester"
EXPTOKEN="6d"
FILEDIR="upload"
# Origin mà nginx đã tự thêm header CORS (mặc định "https://localhost" = app Android Capacitor).
# Backend không thêm header CORS cho các origin này, tránh 2 dòng Access-Control-Allow-Origin.
# Bỏ cấu hình CORS trong nginx thì đặt rỗng: PROXY_CORS_ORIGINS=""
# PROXY_CORS_ORIGINS="https://localhost"
# Origin của app mobile được CORS kèm credentials (trả đúng origin + Allow-Credentials: true).
# Mặc định "capacitor://localhost" = app iOS Capacitor. nginx không được thêm CORS cho các origin này.
# APP_CORS_ORIGINS="capacitor://localhost"
